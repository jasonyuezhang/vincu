context platform=android timeout=60000 retries=1
env APP_ID=sh.vincu.debug

open "${APP_ID}"
wait "id=\"workspace-header-menu-trigger\"" 20000
press "id=\"workspace-header-menu-trigger\""
wait "role=\"button\" label=\"New terminal\"" 10000
press "role=\"button\" label=\"New terminal\""
wait "id=\"terminal-keyboard-toggle\"" 10000
press "id=\"terminal-keyboard-toggle\""
type "clear; printf '                    VINCU_TARGET\\n'" --delay-ms 0
press "id=\"terminal-key-enter\""
wait "text" "VINCU_TARGET" 10000
longpress "label=\"VINCU_TARGET\"" 550
wait "id=\"terminal-copy\"" 10000
is visible "id=\"terminal-copy\""
gesture pan 532 346 400 0 700
is visible "id=\"terminal-copy\""
gesture pan 532 346 -400 0 700
is visible "id=\"terminal-copy\""
close
